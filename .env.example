# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Claude ----------------------------------------------------------------
# Required only for LLM-backed answers and `--extractor llm`. Without it the
# system uses the built-in offline extractive answerer and rule-based extractor.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Generation ------------------------------------------------------------
GRAPHRAG_LLM_MODEL=claude-opus-5
GRAPHRAG_LLM_MAX_TOKENS=8192
# low | medium | high | xhigh | max
GRAPHRAG_LLM_EFFORT=medium
# Seconds before a request is abandoned, and how many transient 429/5xx
# responses to retry before giving up.
GRAPHRAG_LLM_TIMEOUT=120
GRAPHRAG_LLM_MAX_RETRIES=2

# --- Indexing --------------------------------------------------------------
GRAPHRAG_EMBEDDING_MODEL=hashing-512
GRAPHRAG_EMBEDDING_DIM=512
# Words per chunk, and words shared between neighbouring chunks.
GRAPHRAG_CHUNK_SIZE=180
GRAPHRAG_CHUNK_OVERLAP=40
# rule (offline, deterministic) | llm (Claude, needs an API key)
GRAPHRAG_EXTRACTOR=rule
GRAPHRAG_MAX_ENTITIES_PER_CHUNK=12
GRAPHRAG_MIN_ENTITY_LENGTH=3

# --- Retrieval -------------------------------------------------------------
GRAPHRAG_RETRIEVAL_TOP_K=5
# Relative weight of each signal in the rank fusion. 0 disables a signal.
GRAPHRAG_VECTOR_WEIGHT=1.0
GRAPHRAG_KEYWORD_WEIGHT=1.0
GRAPHRAG_GRAPH_WEIGHT=1.0
# Reciprocal-rank-fusion smoothing constant.
GRAPHRAG_RRF_K=60
GRAPHRAG_PAGERANK_ALPHA=0.85
GRAPHRAG_GRAPH_EXPANSION_DEPTH=2
GRAPHRAG_MAX_CONTEXT_CHARS=6000

# --- Storage ---------------------------------------------------------------
GRAPHRAG_STORAGE_DIR=storage
